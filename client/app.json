{
  "expo": {
    "name": "Tavriko",
    "slug": "tavriko",
    "scheme": "tavriko",
    "version": "1.1.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/3eee7ba8-7dc6-4590-bb87-88214d6bfc7d",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "androidStatusBar": {
      "hidden": true,
      "translucent": true,
      "backgroundColor": "#00000000"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.tavriko.app"
    },
    "android": {
      "package": "com.tavriko.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10029F"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "com.google.android.gms.permission.AD_ID",
        "com.android.vending.BILLING"
      ],
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "versionCode": 30
    },
    "splash": {
      "image": "./assets/splash-icon-transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#01025B"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Tavriko",
      "shortName": "Tavriko",
      "backgroundColor": "#1A0B4D",
      "description": "Tavriko: bilgini yarıştır, kazan!"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-transparent.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#01025B",
          "dark": {
            "image": "./assets/splash-icon-transparent.png",
            "backgroundColor": "#01025B"
          },
          "android": {
            "image": "./assets/splash-icon-transparent.png",
            "imageWidth": 260
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "./plugins/notification-sound",
      "./plugins/optional-hardware-features",
      "./plugins/android-architectures",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-web-browser",
      "expo-iap",
      "@react-native-community/datetimepicker",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "tavriko",
          "project": "react-native",
          "disableAutoUpload": true
        }
      ],
      "@sentry/react-native",
      "expo-secure-store",
      "expo-localization",
      "expo-notifications",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9520105697678442~7884767327",
          "delayAppMeasurementInit": true
        }
      ]
    ],
    "backgroundColor": "#1A0B4D",
    "extra": {
      "eas": {
        "projectId": "3eee7ba8-7dc6-4590-bb87-88214d6bfc7d"
      }
    },
    "owner": "safak610"
  }
}
