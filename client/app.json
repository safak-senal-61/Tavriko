{
  "expo": {
    "name": "Tavriko",
    "slug": "tavriko",
    "scheme": "tavriko",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "androidStatusBar": {
      "hidden": true,
      "translucent": true,
      "backgroundColor": "#00000000"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.tavriko.app"
    },
    "android": {
      "package": "com.tavriko.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10029F"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Tavriko",
      "shortName": "Tavriko",
      "backgroundColor": "#1A0B4D",
      "description": "Tavriko: bilgini yarıştır, kazan!"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#1A0B4D",
          "dark": {
            "image": "./assets/splash-logo.png",
            "backgroundColor": "#10062F"
          },
          "android": {
            "image": "./assets/splash-icon.png",
            "imageWidth": 240
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-audio",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "tavriko",
          "project": "react-native",
          "disableAutoUpload": true
        }
      ],
      "@sentry/react-native"
    ],
    "backgroundColor": "#1A0B4D",
    "extra": {
      "eas": {
        "projectId": "3eee7ba8-7dc6-4590-bb87-88214d6bfc7d"
      }
    },
    "owner": "safak610"
  }
}
