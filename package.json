{
  "name": "trivia-verse-multiplayer",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "test:all": "scripts\\run-all-tests.bat",
    "test:shared": "npm --prefix shared test",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client start",
    "build:shared": "npm --prefix shared run build",
    "build:server": "npm --prefix server run build"
  }
}
