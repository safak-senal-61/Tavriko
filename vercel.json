{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/reengage-push",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/reengage-push-evening",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/play-voided",
      "schedule": "30 3 * * *"
    }
  ],
  "buildCommand": "npx prisma generate --schema=server/prisma/schema.prisma && npm run build:shared && npm run build:server && npm run build:client:web",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/.prisma/**",
          "node_modules/@prisma/client/**",
          "node_modules/@trivia/**",
          "shared/**",
          "server/dist/**",
          "server/prisma/**",
          "server/data/**",
          "client/dist/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ]
}
