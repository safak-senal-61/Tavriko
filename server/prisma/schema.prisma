generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id             String     @id
  name           String
  description    String
  icon           String
  color          String
  totalQuestions Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  questions      Question[]

  @@map("categories")
}

model Question {
  id                   String    @id
  categoryId           String
  subCategory          String?
  difficulty           String
  text                 String
  options              Json
  correctOptionId      String
  explanation          String
  sourceOrVerification String?
  language             String    @default("tr")
  contentHash          String    @unique
  reviewStatus         String    @default("published")
  reviewedBy           String?
  reviewedAt           DateTime?
  rejectionReason      String?
  timeLimitSec         Int       @default(15)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  category             Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, difficulty, reviewStatus])
  @@map("questions")
}

model User {
  id                        String              @id
  username                  String              @unique
  email                     String              @unique
  displayName               String
  fullName                  String?
  passwordHash              String?
  googleId                  String?             @unique
  countryCode               String?             @default("TR")
  countryName               String?             @default("Türkiye")
  phone                     String?
  birthDate                 String?
  gender                    String?
  bio                       String?
  avatarUrl                 String?             @default("av1")
  friendCode                String              @unique
  level                     Int                 @default(1)
  xp                        Int                 @default(0)
  coins                     Int                 @default(500)
  gems                      Int                 @default(0)
  dailyStreak               Int                 @default(1)
  rankTitle                 String              @default("Acemi Kaşif")
  rankPoints                Int                 @default(1000)
  profileCompletionPct      Int                 @default(50)
  totalMatches              Int                 @default(0)
  wins                      Int                 @default(0)
  correctAnswers            Int                 @default(0)
  totalAnswers              Int                 @default(0)
  bestStreak                Int                 @default(0)
  avgResponseTimeMs         Int                 @default(0)
  categoryMastery           Json                @default("{}")
  claimedSeasonTiers        Json                @default("[1]")
  friendIds                 Json                @default("[]")
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  restrictedUntil           DateTime?
  supportCases              SupportCase[]
  duelFunnel                DuelFunnelEvent[]
  claimedSeasonFreeTiers    Json                @default("[]")
  claimedSeasonPremiumTiers Json                @default("[]")
  equippedBackground        String?
  equippedBadge             String?
  equippedFrame             String?
  equippedNameEffect        String?
  // Süreli (rental) profil kozmetikleri (milisaniye timestamp — BigInt gerekli)
  equippedBackgroundExpiresAt BigInt?
  equippedBadgeExpiresAt    BigInt?
  equippedFrameExpiresAt    BigInt?
  equippedNameEffectExpiresAt BigInt?
  // Kullanıcının engellediği oyuncular
  blockedUserIds            Json                @default("[]")
  eventProgress             Json                @default("{}")
  hasPremiumPass            Boolean             @default(false)
  seasonXp                  Int                 @default(0)
  settings                  Json                @default("{}")
  matches                   MatchHistory[]
  inventoryItems            UserInventoryItem[]
  notifications             UserNotification[]
  pushTokens                PushToken[]
  referralLink              ReferralLink?
  referralReceived          ReferralRedemption? @relation("ReferralInvitee")
  referralsSent             ReferralRedemption[] @relation("ReferralInviter")
  rewardedAds               RewardedAdAttempt[]
  gameplayRewardClaims      GameplayRewardClaim[]
  polarGemOrders            PolarGemOrder[]
  polarSeasonOrders         PolarSeasonOrder[]
  practiceJokerUses         PracticeJokerUse[]

  @@index([rankPoints(sort: Desc)])
  @@index([xp(sort: Desc)])
  @@map("users")
}

model PolarGemOrder {
  checkoutId String @id
  orderId String? @unique
  userId String
  productId String
  gems Int
  amount Int
  refundedGems Int @default(0)
  status String @default("open")
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("polar_gem_orders")
}

model PolarSeasonOrder {
  checkoutId String @id
  orderId String? @unique
  userId String
  productId String
  amount Int
  sandbox Boolean
  granted Boolean @default(false)
  status String @default("open")
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("polar_season_orders")
}

model PracticeJokerUse {
  userId String
  sessionId String
  questionId String
  jokerId String
  eliminated String[]
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, sessionId, questionId])
  @@map("practice_joker_uses")
}

model GameplayRewardClaim {
  userId    String
  rewardId  String
  claimedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, rewardId])
  @@map("gameplay_reward_claims")
}

model RewardedAdAttempt {
  id            String    @id @db.Uuid
  userId        String
  createdAt     DateTime  @default(now())
  rewardedAt    DateTime?
  transactionId String?   @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, rewardedAt])
  @@index([userId, createdAt])
  @@map("rewarded_ad_attempts")
}

model UserInventoryItem {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  name      String
  desc      String
  qty       Int      @default(1)
  /// Kozmetik süresi (saat). Görev rozetlerinde 0 kalıcı kuşanımı belirtir.
  durationHours Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@map("user_inventory_items")
}

model UserNotification {
  id           String   @id
  userId       String
  type         String
  title        String
  sub          String
  timeText     String
  handled      String?
  senderId     String?
  senderName   String?
  senderAvatar String?
  roomCode     String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_notifications")
}

model PushToken {
  id        String   @id @default(cuid())
  /// Expo Push token (ExponentPushToken[...]); kullanıcı başına birden fazla cihaz olabilir.
  token     String   @unique
  userId    String
  /// ios | android | web (tanım için; gönderim tarafında kullanılmaz)
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model MatchHistory {
  id             String   @id @default(cuid())
  roomCode       String
  mode           String
  categoryId     String
  winnerId       String?
  userId         String?
  score          Int      @default(0)
  correctAnswers Int      @default(0)
  totalQuestions Int      @default(5)
  rankingsJson   Json
  playedAt       DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([playedAt, userId])
  @@index([userId, playedAt])
  @@map("match_history")
}

// No FK to users: keep the operational record if the player deletes the account.
model AdminAccountEvent {
  id        String   @id @default(uuid())
  accountId String
  actor     String
  role      String
  action    String
  reason    String
  details   Json
  createdAt DateTime @default(now())

  @@index([accountId, createdAt, id])
  @@map("admin_account_events")
}

model AdminCompensation {
  id          String   @id @db.Uuid
  accountId   String
  requester   String
  reviewer    String?
  kind        String
  itemId      String?
  amount      Int
  status      String
  reason      String
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  decidedAt   DateTime?

  @@index([accountId, kind, status, decidedAt])
  @@index([status, expiresAt, createdAt])
  @@index([requester, createdAt])
  @@map("admin_compensations")
}

model SupportCase {
  id             String   @id @default(uuid()) @db.Uuid
  accountId      String
  account        User     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind           String
  subject        String
  message        String
  moderationId   String?  @unique
  assignee       String?
  status         String   @default("open")
  resolution     String?
  revision       Int      @default(0)
  waitingForPlayer Boolean @default(false)
  firstReplyAt   DateTime?
  replies        SupportCaseReply[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([accountId, createdAt])
  @@index([kind, status, createdAt, id])
  @@index([firstReplyAt, status, createdAt])
  @@map("support_cases")
}

model SupportCaseReply {
  id        String      @id @default(uuid()) @db.Uuid
  caseId    String      @db.Uuid
  ticket    SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sender    String
  body      String
  createdAt DateTime    @default(now())

  @@index([caseId, createdAt, id])
  @@map("support_case_replies")
}

model PortalSession {
  id        String    @id @db.Uuid
  email     String
  method    String
  device    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  revokedBy String?
  passkeyId String?

  @@index([email, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("portal_sessions")
}

model PortalPasskey {
  id        String   @id
  email     String
  publicKey Bytes
  counter   BigInt
  createdAt DateTime @default(now())

  @@index([email])
  @@map("portal_passkeys")
}

model PortalWebAuthnChallenge {
  id        String   @id @db.Uuid
  challenge String
  purpose   String
  binding   String
  expiresAt DateTime

  @@index([expiresAt])
  @@map("portal_webauthn_challenges")
}

model DuelFunnelEvent {
  accountId String
  account   User     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stage     String
  room      String
  at        DateTime

  @@id([accountId, stage, room])
  @@index([at])
  @@map("duel_funnel_events")
}

model AdminRiskAlert {
  id          String   @id @default(uuid()) @db.Uuid
  actor       String
  count       Int
  createdAt   DateTime @default(now())
  reviewedAt  DateTime?
  reviewer    String?
  reason      String?

  @@index([actor, createdAt])
  @@index([reviewedAt, createdAt, id])
  @@map("admin_risk_alerts")
}

model PortalOtpState {
  email       String @id
  factor      String
  lastStep    Int    @default(-1)
  window      Int
  attempts    Int

  @@map("portal_otp_states")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, code])
  @@map("password_reset_tokens")
}

model ReferralLink {
  token     String   @id
  inviterId String   @unique
  createdAt DateTime @default(now())
  inviter   User     @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  redemptions ReferralRedemption[]

  @@map("referral_links")
}

model ReferralRedemption {
  inviteeId   String   @id
  inviterId   String
  token       String
  rewardCoins Int      @default(0)
  createdAt   DateTime @default(now())
  invitee     User    @relation("ReferralInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviter     User    @relation("ReferralInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  link        ReferralLink @relation(fields: [token], references: [token], onDelete: Cascade)

  @@index([inviterId], map: "referral_redemptions_inviter_idx")
  @@map("referral_redemptions")
}
