{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tavriko-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoomDO"
      },
      {
        "name": "MATCHMAKER",
        "class_name": "MatchmakerDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoomDO", "MatchmakerDO"]
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "BACKEND_API_URL": "https://tavriko-app.vercel.app",
    "JWT_SECRET": "super_secret_jwt_key_trivia_2026_production",
    "INTERNAL_API_SECRET": "tavriko_internal_secret_2026",
    "RECONNECTION_GRACE_SEC": 60,
    "ROUND_INTERMISSION_SEC": 3.5,
    "COUNTDOWN_DURATION_SEC": 3
  }
}
